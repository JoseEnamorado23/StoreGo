# Plantilla de Caddy (HTTPS automatico). Reemplaza TU_DOMINIO por tu dominio.
#
# app.TU_DOMINIO {
#     reverse_proxy frontend:3000
# }
#
# api.TU_DOMINIO {
#     reverse_proxy backend:8000
# }
#
# La URL del webhook de Factus Pay a registrar en el panel sera:
#   https://api.TU_DOMINIO/api/webhooks/factus-pay?key=TU_LLAVE
