# HTTPS automático (Let's Encrypt) para {$DOMAIN}. El valor viene de deploy/.env.
{$DOMAIN} {
	encode zstd gzip

	# Log de acceso en stdout. El webhook de Factus Pay lleva la llave en ?key=:
	# se reemplaza en el log para que nunca quede escrita.
	log {
		output stdout
		format filter {
			wrap json
			request>uri query {
				replace key REDACTED
			}
		}
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
