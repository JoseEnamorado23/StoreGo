# Copia a deploy/.env (cp deploy/.env.example deploy/.env) y edita con nano.
# deploy/.env NO se sube a GitHub. Todos los valores de abajo son falsos.

# --- Dominio público (sin https://). Caddy saca el certificado solo ---
DOMAIN=54-209-92-85.sslip.io

# --- Base de datos (solo accesible dentro de Docker) ---
POSTGRES_PASSWORD=cambia_esto_por_una_clave_larga

# --- App ---
# dev  = al arrancar siembra 15 productos de ejemplo (idempotente: repone los que falten
#        en cada reinicio). Útil para la demo. NO borra ni cambia nada existente.
# prod = no siembra; el catálogo empieza vacío.
# Recomendado: dev el primer arranque de la demo, luego prod.
APP_ENV=dev
APP_ADMIN_EMAIL=tendero@tienda.local
APP_ADMIN_PASSWORD=cambia_esto
# Genera uno con:  openssl rand -hex 32
JWT_SECRET=cambia_esto_por_algo_de_64_caracteres

# --- Factus ---
# fake = sin credenciales, pagos simulados con /api/dev/simular-pago/{ref}
# real = sandbox de Factus (pon las credenciales de abajo)
FACTUS_MODE=fake
# Prefijo único del equipo para los reference_code
REFERENCE_PREFIX=TFXX
FACTUS_BASE_URL=https://api-sandbox.factus.com.co
FACTUS_CLIENT_ID=tu_client_id
FACTUS_CLIENT_SECRET=tu_client_secret
FACTUS_USERNAME=tu_usuario
FACTUS_PASSWORD=tu_clave
FACTUS_PAY_BASE_URL=https://pay-api-sandbox.factus.com.co
FACTUS_PAY_EMAIL=tu_correo
FACTUS_PAY_PASSWORD=tu_clave
# Llave del webhook (la misma que va en ?key= en el panel de Factus Pay). Genera: openssl rand -hex 24
FACTUS_PAY_WEBHOOK_KEY=una_llave_de_32_caracteres_o_mas
PAY_MIN_AMOUNT=10000
PAY_MAX_AMOUNT=12000000
# Opcional: ids de rangos de numeración (vacío = automático)
FACTUS_RANGO_FACTURA=
FACTUS_RANGO_NC=
FACTUS_RANGO_ND=

# --- Voz / IA ---
LLM_PROVIDER=groq
LLM_API_KEY=tu_llave_de_la_ia
LLM_MODEL=
VOZ_USAR_IA=true
